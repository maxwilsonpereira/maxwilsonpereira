import '@/styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página não encontrada | Max Wilson Pereira</title><meta name="description" content="A página solicitada não foi encontrada." /><meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/optimized/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;600;700&amp;family=Italiana&amp;display=swap" />
  </head>
  <body class="page-sub"><div class="hero-bg" aria-hidden="true"></div><Header locale="pt" route="home" /><main class="page-container error-page" id="main-content"><section class="content-section editorial-section--centered"><p class="editorial-eyebrow">Erro 404</p><h1>Página não encontrada</h1><p>O endereço pode ter mudado ou não existir. Volte ao início para continuar explorando a música e a trajetória de Max Wilson Pereira.</p><a class="primary-button" href="/">Voltar ao início</a></section></main><Footer locale="pt" route="home" /></body>
