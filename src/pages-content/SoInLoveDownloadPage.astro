---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/Badge.astro';
import AlbumArtwork from '@/components/AlbumArtwork.astro';
import AudioTrackList from '@/components/AudioTrackList.astro';
import type { Locale } from '@/config/site';
import { bonusTracks, soInLoveTracks } from '@/data/media';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isInternational = locale !== 'pt';
const copyByLocale = {
  pt: {
    badge: 'Álbum digital liberado',
    intro: 'Ouça online, baixe faixa por faixa ou salve o álbum completo em um arquivo único.',
    downloadAll: 'Baixar todas as músicas',
    unavailable: 'Indisponível fora do Brasil',
    tracks: 'Suas músicas',
    bonus: 'Faixas Bônus',
    trackCount: '13 faixas',
    play: 'Play',
    pause: 'Pausar',
    download: 'Baixar',
    audioFallback: 'Seu navegador não suporta reprodução de áudio.',
    noteTitle: '',
    noteBody: '',
  },
  en: {
    badge: 'Digital album',
    intro: 'Listen online or download the available gift tracks.',
    downloadAll: 'Download gift songs',
    unavailable: 'Unavailable outside Brazil',
    tracks: 'Your songs',
    bonus: 'Bonus tracks',
    trackCount: '13 tracks',
    play: 'Play',
    pause: 'Pause',
    download: 'Download',
    audioFallback: 'Your browser does not support audio playback.',
    noteTitle: 'A note for listeners outside Brazil',
    noteBody: 'This album can only be purchased in Brazil, but I am very glad to offer some of the songs to you as a gift. I hope these tracks bring you joy, and thank you for listening from afar.',
  },
  es: {
    badge: 'Álbum digital',
    intro: 'Escucha en línea o descarga las canciones de regalo disponibles.',
    downloadAll: 'Descargar canciones de regalo',
    unavailable: 'No disponible fuera de Brasil',
    tracks: 'Tus canciones',
    bonus: 'Canciones extra',
    trackCount: '13 canciones',
    play: 'Reproducir',
    pause: 'Pausar',
    download: 'Descargar',
    audioFallback: 'Tu navegador no admite la reproducción de audio.',
    noteTitle: 'Una nota para quienes escuchan fuera de Brasil',
    noteBody: 'Este álbum solo se puede comprar en Brasil, pero me alegra mucho ofrecerte algunas canciones como regalo. Espero que te traigan alegría y gracias por escucharme desde lejos.',
  },
  de: {
    badge: 'Digitales Album',
    intro: 'Hören Sie online oder laden Sie die verfügbaren Geschenktitel herunter.',
    downloadAll: 'Geschenkte Lieder herunterladen',
    unavailable: 'Außerhalb Brasiliens nicht verfügbar',
    tracks: 'Ihre Lieder',
    bonus: 'Bonustitel',
    trackCount: '13 Titel',
    play: 'Abspielen',
    pause: 'Pause',
    download: 'Herunterladen',
    audioFallback: 'Ihr Browser unterstützt die Audiowiedergabe nicht.',
    noteTitle: 'Ein Hinweis für Hörer außerhalb Brasiliens',
    noteBody: 'Dieses Album kann nur in Brasilien gekauft werden, aber ich freue mich sehr, Ihnen einige der Lieder als Geschenk zu geben. Ich hoffe, diese Titel machen Ihnen Freude, und danke Ihnen fürs Zuhören aus der Ferne.',
  },
} as const satisfies Record<Locale, Record<string, string>>;
const copy = copyByLocale[locale];
---
<BaseLayout {locale} route="soInLoveDownload">
  {!isInternational && (
    <dialog class="modal album-support-modal" id="payment-thank-you-modal" aria-labelledby="payment-thank-you-title" data-open-on-load>
      <div class="modal-panel"><button class="modal-close" type="button" aria-label="Fechar aviso" data-modal-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button><div class="modal-header"><span class="modal-eyebrow">SO IN LOVE</span><h2 id="payment-thank-you-title">Obrigado pelo seu apoio</h2></div><div class="modal-body"><p>Se você efetuou o <strong>PIX</strong>, muito obrigado! Seu interesse e seu apoio ao meu trabalho <strong>significam muito para mim</strong>. ❤️❤️❤️</p><p>Quero te dizer algo com toda sinceridade: eu optei por <strong>não bloquear o download</strong>, mesmo antes de conferir o pagamento. Eu escolho <strong>confiar em você</strong>, que me acompanha e apoia minha jornada com carinho e respeito.</p><p>Se ainda não fez o pagamento, peço com todo respeito que <strong>só faça o download depois de ter efetuado o pagamento</strong>.</p><p>Vou ficar muito feliz se escolher uma das músicas e <strong>compartilhar um story no Instagram me marcando</strong>.</p><div class="modal-quote-group" aria-label="Sugestões para story"><p>Você pode escrever algo simples como:</p><blockquote>"Comprei o álbum SO IN LOVE do @maxwilsonpereira e estou adorando! 🎶"</blockquote><blockquote>"Estou ouvindo SO IN LOVE do tenor @maxwilsonpereira e estou adorando! 🎶"</blockquote></div><p>Isso ajuda <strong>muito mais pessoas</strong> a descobrirem minha música.</p></div></div>
    </dialog>
  )}
  <main class="page-container album-page" id="main-content">
    <section class="album-hero"><AlbumArtwork slug="so-in-love" label="Capas do álbum SO IN LOVE" frontAlt="Capa do álbum SO IN LOVE" backAlt="Contracapa do álbum SO IN LOVE" /><div class="album-hero-copy"><Badge text={copy.badge} /><p class="album-kicker">Max Wilson Pereira</p><h1>SO IN LOVE</h1><p>{copy.intro}</p><button class="primary-button album-download-all" type="button" disabled={isInternational} title={isInternational ? copy.unavailable : undefined} aria-label={isInternational ? copy.unavailable : undefined}>{copy.downloadAll}</button>{isInternational && <aside class="album-international-note"><h2>{copy.noteTitle}</h2><p>{copy.noteBody}</p></aside>}</div></section>
    <section class="content-section album-player-section"><div class="album-section-heading"><div><p class="album-eyebrow">{copy.trackCount}</p><h2>{copy.tracks}</h2></div><span class="album-format">MP3</span></div><AudioTrackList tracks={soInLoveTracks} playLabel={copy.play} pauseLabel={copy.pause} audioFallback={copy.audioFallback} downloadable downloadLabel={copy.download} enabledLimit={isInternational ? 5 : undefined} unavailableLabel={copy.unavailable} /></section>
    <section class="content-section album-player-section"><div class="album-section-heading"><div><p class="album-eyebrow">{copy.bonus}</p><h2>{copy.tracks}</h2></div><span class="album-format">MP3</span></div><AudioTrackList tracks={bonusTracks} playLabel={copy.play} pauseLabel={copy.pause} audioFallback={copy.audioFallback} downloadable downloadLabel={copy.download} enabledLimit={isInternational ? 4 : undefined} unavailableLabel={copy.unavailable} /></section>
  </main>
</BaseLayout>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#payment-thank-you-modal');
  if (modal) {
    modal.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', () => modal.close()));
    modal.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
    if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
  }

  const downloadAll = document.querySelector<HTMLButtonElement>('.album-download-all');
  if (downloadAll && !downloadAll.disabled) {
    downloadAll.addEventListener('click', () => {
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.track-item a[download]')];
      downloadAll.disabled = true;
      const original = downloadAll.textContent;
      downloadAll.textContent = 'Preparando downloads...';
      links.forEach((link, index) => setTimeout(() => {
        link.click();
        if (index === links.length - 1) setTimeout(() => {
          downloadAll.disabled = false;
          downloadAll.textContent = original;
        }, 800);
      }, index * 250));
    });
  }
</script>
