---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_NAME, SITE_URL, locales, translatedRouteKeys, urlFor, type Locale, type RouteKey } from '@/config/site';
import { getSeo } from '@/data/seo';
import { buildStructuredData } from '@/utils/structured-data';
import { t } from '@/i18n';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  route: RouteKey;
  bodyClass?: string;
  preloadImage?: { src: string; srcset?: string; sizes?: string; type?: string };
}

const { locale, route, bodyClass = 'page-sub', preloadImage } = Astro.props;
const localeInfo = locales[locale];
const seo = getSeo(route, locale);
const canonical = urlFor(route, locale);
const image = new URL(seo.image ?? '/assets/optimized/og-max-wilson.jpg', SITE_URL).href;
const hasTranslations = (translatedRouteKeys as readonly RouteKey[]).includes(route);
const schema = buildStructuredData(route, locale, seo);
---

<!doctype html>
<html lang={localeInfo.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    {route === 'soInLoveDownload' && locale === 'pt' && (
      <script is:inline>
        const requestedLocale = new URLSearchParams(location.search).get('lang');
        if (requestedLocale && ['en', 'es', 'de'].includes(requestedLocale)) {
          location.replace(`/${requestedLocale}${location.pathname}${location.hash}`);
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={SITE_NAME} />
    {seo.noindex
      ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonical} />
    {hasTranslations && Object.keys(locales).map((code) => (
      <link rel="alternate" hreflang={locales[code as Locale].htmlLang} href={urlFor(route, code as Locale)} />
    ))}
    {hasTranslations && <link rel="alternate" hreflang="x-default" href={urlFor(route, 'pt')} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/optimized/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/optimized/site-icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/optimized/apple-touch-icon.png" />
    <meta property="og:type" content={seo.type ?? 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.ogDescription ?? seo.description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content={seo.imageMime} />
    <meta property="og:image:width" content={String(seo.imageWidth)} />
    <meta property="og:image:height" content={String(seo.imageHeight)} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta property="og:locale" content={localeInfo.ogLocale} />
    {hasTranslations && Object.keys(locales).filter((code) => code !== locale).map((code) => (
      <meta property="og:locale:alternate" content={locales[code as Locale].ogLocale} />
    ))}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.ogDescription ?? seo.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Italiana&amp;display=swap" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{t(locale, 'Pular para o conteúdo')}</a>
    {route !== 'home' && <div class="hero-bg" aria-hidden="true"></div>}
    <Header {locale} {route} />
    <slot />
    <Footer {locale} {route} />
  </body>
</html>
