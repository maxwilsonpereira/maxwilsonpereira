---
import SocialLinks from './SocialLinks.astro';
import { type Locale } from '@/config/site';
import { t } from '@/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<section class="social-follow" aria-labelledby="social-follow-title">
  <div class="social-follow-inner">
    <h2 id="social-follow-title" class="social-follow-kicker">{t(locale, 'Siga nas redes sociais')}</h2>
    <nav class="social-links" aria-label={t(locale, 'Redes sociais de Max Wilson Pereira')}>
      <SocialLinks {locale} className="social-link" showLabel />
    </nav>
  </div>
</section>
