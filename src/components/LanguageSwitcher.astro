---
import { locales, pathFor, type Locale, type RouteKey } from '@/config/site';
import { t } from '@/i18n';

interface Props {
  locale: Locale;
  route: RouteKey;
  specialFlow?: 'soInLove';
}

const { locale, route, specialFlow } = Astro.props;
---
<div class="language-switcher" aria-label={t(locale, 'Escolher idioma')}>
  {Object.keys(locales).map((code) => {
    const targetLocale = code as Locale;
    const language = locales[targetLocale];
    const accessibleLabel = `${t(locale, 'Mudar idioma para')} ${language.label}`;
    const isCurrent = targetLocale === locale;
    const targetHref = specialFlow === 'soInLove'
      ? targetLocale === 'pt'
        ? pathFor('soInLovePurchase')
        : pathFor('soInLoveDownload', targetLocale)
      : pathFor(route, targetLocale);
    return (
      isCurrent ? (
        <span
          class="language-switch-link is-active"
          role="img"
          aria-label={`${t(locale, 'Idioma atual')}: ${language.label}`}
          aria-current="page"
          title={language.label}
        >
          <span class:list={['language-switch-flag', `language-switch-flag-${targetLocale}`]} aria-hidden="true"></span>
        </span>
      ) : (
        <a
          class:list={['language-switch-link', { 'is-active': isCurrent }]}
          href={targetHref}
          lang={language.htmlLang}
          hreflang={language.htmlLang}
          aria-label={accessibleLabel}
          aria-current={isCurrent ? 'page' : undefined}
          aria-disabled={isCurrent ? 'true' : undefined}
          tabindex={isCurrent ? '-1' : undefined}
          title={language.label}
          data-language-locale={targetLocale}
        >
          <span class:list={['language-switch-flag', `language-switch-flag-${targetLocale}`]} aria-hidden="true"></span>
        </a>
      )
    );
  })}
</div>
