---
import { locales, pathFor, type Locale, type RouteKey } from '@/config/site';
import { t } from '@/i18n';

interface Props {
  locale: Locale;
  route: RouteKey;
  specialFlow?: 'soInLove';
}

const { locale, route, specialFlow } = Astro.props;
---
<div class="language-switcher" aria-label={t(locale, 'Escolher idioma')} data-language-query-switcher={specialFlow ? 'so-in-love' : undefined}>
  {Object.keys(locales).map((code) => {
    const targetLocale = code as Locale;
    const language = locales[targetLocale];
    const accessibleLabel = `${t(locale, 'Mudar idioma para')} ${language.label}`;
    const isCurrent = targetLocale === locale;
    const targetHref = specialFlow === 'soInLove'
      ? targetLocale === 'pt'
        ? pathFor('soInLovePurchase')
        : `${pathFor('soInLoveDownload')}?lang=${targetLocale}`
      : pathFor(route, targetLocale);
    return (
      isCurrent && !specialFlow ? (
        <span
          class="language-switch-link is-active"
          role="img"
          aria-label={`${t(locale, 'Idioma atual')}: ${language.label}`}
          aria-current="page"
          title={language.label}
        >
          <span class:list={['language-switch-flag', `language-switch-flag-${targetLocale}`]} aria-hidden="true"></span>
        </span>
      ) : (
        <a
          class:list={['language-switch-link', { 'is-active': isCurrent }]}
          href={targetHref}
          lang={language.htmlLang}
          hreflang={language.htmlLang}
          aria-label={accessibleLabel}
          aria-current={isCurrent ? 'page' : undefined}
          aria-disabled={isCurrent ? 'true' : undefined}
          tabindex={isCurrent ? '-1' : undefined}
          title={language.label}
          data-language-locale={targetLocale}
        >
          <span class:list={['language-switch-flag', `language-switch-flag-${targetLocale}`]} aria-hidden="true"></span>
        </a>
      )
    );
  })}
</div>

<script>
  const supportedLocales = new Set(['pt', 'en', 'es', 'de']);

  document.querySelectorAll<HTMLElement>('[data-language-query-switcher="so-in-love"]').forEach((switcher) => {
    const queryLocale = new URLSearchParams(window.location.search).get('lang');
    const currentLocale = queryLocale && supportedLocales.has(queryLocale) ? queryLocale : 'pt';

    switcher.querySelectorAll<HTMLAnchorElement>('[data-language-locale]').forEach((link) => {
      const isCurrent = link.dataset.languageLocale === currentLocale;
      link.classList.toggle('is-active', isCurrent);
      if (isCurrent) {
        link.setAttribute('aria-current', 'page');
        link.setAttribute('aria-disabled', 'true');
        link.setAttribute('tabindex', '-1');
      } else {
        link.removeAttribute('aria-current');
        link.removeAttribute('aria-disabled');
        link.removeAttribute('tabindex');
      }
      link.addEventListener('click', (event) => {
        if (link.getAttribute('aria-disabled') === 'true') event.preventDefault();
      });
    });
  });
</script>
