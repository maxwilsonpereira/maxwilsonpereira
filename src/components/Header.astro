---
import LanguageSwitcher from './LanguageSwitcher.astro';
import SocialLinks from './SocialLinks.astro';
import { SITE_NAME, navigation, pathFor, translatedRouteKeys, type Locale, type RouteKey } from '@/config/site';
import { t } from '@/i18n';

interface Props { locale: Locale; route: RouteKey; }
const { locale, route } = Astro.props;
const hasTranslations = (translatedRouteKeys as readonly RouteKey[]).includes(route);
const hasSoInLoveLanguageFlow = route === 'soInLovePurchase' || route === 'soInLoveDownload';
const showLanguageSwitcher = hasTranslations || hasSoInLoveLanguageFlow;
const albumSectionRoutes = new Set<RouteKey>(['albums', 'tenoriAmici', 'quattro', 'soInLovePurchase', 'soInLoveDownload']);
const activeNavigationRoute: RouteKey = albumSectionRoutes.has(route) ? 'albums' : route;
const mobileHeaderLocales = ['pt', 'en'] as const satisfies readonly Locale[];
const navId = 'site-navigation';
---
<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a class="site-brand" href={pathFor('home', locale)} aria-label={`${SITE_NAME} - Home`}>
      <span class="site-brand-wordmark" aria-hidden="true">
        <span class="site-brand-primary">Max Wilson</span>
        <span class="site-brand-secondary">Pereira</span>
      </span>
    </a>
    <nav class="site-nav" id={navId} aria-label={t(locale, 'Navegação principal')} data-site-nav>
      <div class="site-nav-links">
        {navigation.map((item) => {
          const isActive = activeNavigationRoute === item.route;
          const currentState = route === item.route ? 'page' : isActive ? 'location' : undefined;
          return (
            <a class:list={['site-nav-link', { 'is-active': isActive }]} href={pathFor(item.route, locale)} aria-current={currentState}>
              {t(locale, item.label)}
            </a>
          );
        })}
      </div>
      <div class="site-nav-mobile-meta">
        {showLanguageSwitcher && <div class="site-nav-mobile-languages"><LanguageSwitcher {locale} {route} specialFlow={hasSoInLoveLanguageFlow ? 'soInLove' : undefined} /></div>}
        <div class="site-nav-mobile-socials" aria-label={t(locale, 'Redes sociais')}>
          <SocialLinks {locale} className="site-nav-social-link" />
        </div>
      </div>
    </nav>
    <div class="site-header-actions">
      {showLanguageSwitcher && <LanguageSwitcher {locale} {route} specialFlow={hasSoInLoveLanguageFlow ? 'soInLove' : undefined} />}
      <div class="site-nav-socials" aria-label={t(locale, 'Redes sociais')}>
        <SocialLinks {locale} className="site-nav-social-link" />
      </div>
    </div>
    {showLanguageSwitcher && <div class="site-header-mobile-languages"><LanguageSwitcher {locale} {route} specialFlow={hasSoInLoveLanguageFlow ? 'soInLove' : undefined} visibleLocales={mobileHeaderLocales} /></div>}
    <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls={navId} aria-label={t(locale, 'Abrir menu')} data-menu-toggle data-open-label={t(locale, 'Abrir menu')} data-close-label={t(locale, 'Fechar menu')}>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && nav && toggle) {
    let menuTransitionTimer: ReturnType<typeof setTimeout> | undefined;
    let menuToggleUsesKeyboard = false;
    const setOpen = (open: boolean, shouldAnimate = false, shouldFocusFirstLink = false) => {
      clearTimeout(menuTransitionTimer);
      nav.classList.toggle('is-menu-transitioning', shouldAnimate);
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('site-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel ?? '' : toggle.dataset.openLabel ?? '');
      if (open && shouldFocusFirstLink) {
        requestAnimationFrame(() => nav.querySelector<HTMLAnchorElement>('a')?.focus());
      }
      if (shouldAnimate) {
        menuTransitionTimer = setTimeout(() => nav.classList.remove('is-menu-transitioning'), 600);
      }
    };
    toggle.addEventListener('keydown', (event) => {
      menuToggleUsesKeyboard = event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar';
    });
    toggle.addEventListener('click', (event) => {
      const shouldFocusFirstLink = menuToggleUsesKeyboard || event.detail === 0;
      menuToggleUsesKeyboard = false;
      setOpen(!nav.classList.contains('is-open'), true, shouldFocusFirstLink);
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false, true)));
    document.addEventListener('keydown', (event) => {
      if (!nav.classList.contains('is-open')) return;
      if (event.key === 'Escape') { setOpen(false, true); toggle.focus(); return; }
      if (event.key !== 'Tab') return;
      const focusable = [...nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'), toggle];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
    const syncHeader = () => header.classList.toggle('is-scrolled', scrollY > 24);
    syncHeader();
    addEventListener('scroll', syncHeader, { passive: true });
  }
</script>
